/onlinecourse/course/gis/11_analysis2/11_analysis2_interp3_hu_8e383bd96c54f8f9.webp 1200w"
src="https://thaytunghanu.github.io/onlinecourse/course/gis/11_analysis2/11_analysis2_interp3_hu_a305e38c47cff1bf.webp"
width="727"
height="760"
loading="lazy" data-zoomable />&lt;/div>
&lt;/div>&lt;figcaption>
&lt;strong>Add Delimited Text&lt;/strong> dữ liệu csv xâm nhập mặn đã tích hợp tọa độ
&lt;/figcaption>&lt;/figure>
&lt;br>
&lt;figure id="figure-vị-trí-các-trạm-đo-mặn-ở-map-canvas-sau-khi-add-delimited-text">
&lt;div class="d-flex justify-content-center">

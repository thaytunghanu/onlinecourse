&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">WHEN &amp;#34;value&amp;#34; = 60 THEN &amp;#39;Bare / sparse vegetation&amp;#39;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">WHEN &amp;#34;value&amp;#34; = 70 THEN &amp;#39;Snow and Ice&amp;#39;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">WHEN &amp;#34;value&amp;#34; = 80 THEN &amp;#39;Permanent water bodies&amp;#39;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">WHEN &amp;#34;value&amp;#34; = 90 THEN &amp;#39;Herbaceous wetland&amp;#39;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">WHEN &amp;#34;value&amp;#34; = 95 THEN &amp;#39;Mangroves&amp;#39;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">WHEN &amp;#34;value&amp;#34; = 100 THEN &amp;#39;Moss and lichen&amp;#39;
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl">END
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;p>
